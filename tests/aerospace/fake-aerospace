#!/bin/bash

set -euo pipefail

if [[ -n "${FAKE_AEROSPACE_LOG:-}" ]]; then
    printf '%s\n' "$*" >> "$FAKE_AEROSPACE_LOG"
fi

if [[ "${FAKE_AEROSPACE_DISABLED:-false}" == true ]]; then
    echo "AeroSpace server is disabled and doesn't accept commands." >&2
    exit 1
fi

case "$1" in
    list-monitors)
        printf '%b\n' "$FAKE_MONITORS"
        ;;
    list-workspaces)
        if [[ " $* " == *" --focused "* ]]; then
            if [[ -n "${FAKE_FOCUSED_WORKSPACES:-}" && -n "${FAKE_FOCUSED_WORKSPACE_CALLS_FILE:-}" ]]; then
                focused_workspace_call=0
                [[ -f "$FAKE_FOCUSED_WORKSPACE_CALLS_FILE" ]] && focused_workspace_call="$(<"$FAKE_FOCUSED_WORKSPACE_CALLS_FILE")"
                focused_workspace_call=$((focused_workspace_call + 1))
                printf '%s\n' "$focused_workspace_call" > "$FAKE_FOCUSED_WORKSPACE_CALLS_FILE"
                IFS=',' read -r -a focused_workspaces <<< "$FAKE_FOCUSED_WORKSPACES"
                focused_workspace_index=$((focused_workspace_call - 1))
                if ((focused_workspace_index >= ${#focused_workspaces[@]})); then
                    focused_workspace_index=$((${#focused_workspaces[@]} - 1))
                fi
                printf '%s\n' "${focused_workspaces[$focused_workspace_index]}"
            else
                printf '%s\n' "${FAKE_FOCUSED_WORKSPACE:-1}"
            fi
        elif [[ " $* " == *" --visible "* ]]; then
            printf '%b\n' "${FAKE_VISIBLE_WORKSPACES:-${FAKE_FOCUSED_WORKSPACE:-1}}"
        else
            if [[ " $* " == *"monitor-appkit-nsscreen-screens-id"* ]]; then
                printf '%b\n' "${FAKE_WORKSPACE_DISPLAYS:-$FAKE_WORKSPACES}"
            else
                printf '%b\n' "$FAKE_WORKSPACES"
            fi
        fi
        ;;
    list-windows)
        if [[ " $* " == *" --focused "* ]]; then
            printf '%b\n' "${FAKE_FOCUSED_WINDOW:-}"
            exit 0
        fi

        workspace=""
        for ((index = 1; index <= $#; index++)); do
            if [[ "${!index}" == "--workspace" ]]; then
                ((index++))
                workspace="${!index}"
                break
            fi
        done
        window_variable="FAKE_WORKSPACE_WINDOWS_${workspace}"
        printf '%b\n' "${!window_variable:-}"
        ;;
    eval|workspace|move-node-to-workspace|reload-config|mode)
        ;;
    *)
        echo "Unexpected fake AeroSpace command: $*" >&2
        exit 1
        ;;
esac
